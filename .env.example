# Optional: only needed for `meeting.py publish` (direct Notion API).
# Inside Claude Code the skill can publish through the Notion MCP instead, no token needed.
# Create an internal integration at https://www.notion.so/my-integrations and share the database with it.
NOTION_TOKEN=
# Database id (32 hex chars from the database URL). Properties expected:
# Title, Date, Platform, Participants, Duration (min), Summary, Action items, Recording
NOTION_DB_ID=
# Where recordings go (default ~/Meetings)
# MEETINGS_DIR=
